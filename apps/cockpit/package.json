{
  "name": "@t3-pilot/cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-external-CDN Vite + React Visual Pilot Cockpit for T3 Code Preview pane and GitHub Pages interactive demo",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4733",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4733"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0"
  }
}
