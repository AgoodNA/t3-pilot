{
  "name": "t3-pilot",
  "version": "0.2.0",
  "description": "Turn expiring AI quota into morning surprises — 7d x 5h coupled Sparkle harvester, Guarded Turbo safety shield, 20% emergency reserve router, and Visual Cockpit for T3 Code",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "cockpit-dist",
    "README.md",
    "LICENSE",
    "native-ui-overlay"
  ],
  "bin": {
    "t3-pilot": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@t3-pilot/core": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgoodNA/t3-pilot.git"
  },
  "homepage": "https://agoodna.github.io/t3-pilot/?demo=1",
  "bugs": {
    "url": "https://github.com/AgoodNA/t3-pilot/issues"
  },
  "keywords": [
    "t3code",
    "t3-code",
    "ai-agents",
    "mcp",
    "claude-code",
    "codex",
    "antigravity",
    "quota",
    "autopilot",
    "guardrails"
  ]
}
